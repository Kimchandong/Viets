{
  "expo": {
    "name": "Viet's",
    "slug": "viets-app",
    "scheme": "viets",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.viets.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.viets.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDVX3Qm-EzrVJ8Odw6eIvmdepxx_GBcchg"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "채팅에서 사진을 첨부하려면 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 매물을 거리순으로 보여주기 위해 현재 위치를 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F3C7E"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70e9be62-ccd0-4662-b884-2c6d28874a98"
      }
    },
    "owner": "hilliary7"
  }
}
